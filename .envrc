# Keep caches and tool state inside the checkout, because DSH's workspace-write
# sandbox mounts $HOME read-only.
#
# XDG_CACHE_HOME must precede `use flake`: the shell it evaluates needs it for
# nix's fetcher locks. It also relocates typst's package cache and the Bun cache
# behind `backlog`, which default to ~/.cache; Bun refuses to start when it
# cannot write that cache.
export XDG_CACHE_HOME="$PWD/.local/cache"
# npm ignores XDG_CACHE_HOME and fails on a read-only ~/.npm; keep installs and
# npx caches here instead.
export npm_config_cache="$PWD/.local/npm-cache"

use flake
