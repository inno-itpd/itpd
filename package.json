{
  "name": "itpd-markdown-tooling",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "^26.0.0"
  },
  "scripts": {
    "fmt": "oxfmt scripts prettier eslint eslint.config.ts",
    "fmt:check": "oxfmt --check scripts prettier eslint eslint.config.ts",
    "build:lectures": "node scripts/lectures.mjs build",
    "check:lectures": "node scripts/lectures.mjs check",
    "lint:markdown": "node scripts/markdown.mjs lint",
    "format:markdown": "node scripts/markdown.mjs format",
    "format:markdown:check": "node scripts/markdown.mjs format:check",
    "test:markdown-rules": "vitest run eslint/markdown/",
    "test:markdown-format": "vitest run prettier/markdown/"
  },
  "devDependencies": {
    "@eslint/markdown": "^8.0.3",
    "eslint": "^10.10.0",
    "eslint-markdown": "^0.18.1",
    "eslint-plugin-sentences-per-line": "^0.1.3",
    "jiti": "^2.7.0",
    "oxfmt": "^0.71.0",
    "prettier": "^3.9.8",
    "prettier-plugin-sentences-per-line": "^0.2.5",
    "vitest": "^5.0.3"
  }
}
